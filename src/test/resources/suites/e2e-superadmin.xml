<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Indus Towers - SUPERADMIN - E2E Suite" verbose="1">
    <listeners>
        <listener class-name="indus.listener.Listener" />
    </listeners>
    <test thread-count="1" name="superadmin e2e tests">
        <groups>
            <run>
                <include name="E2E" />
            </run>
        </groups>
        <classes>
            <class name="indus.tests.LoginTestValidation" />
            <class name="indus.tests.SuperAdminTest" />
        </classes>
    </test>
</suite>
